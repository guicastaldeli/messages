# ============================================================
# Stage 1: Builder
# ============================================================
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files first for caching
COPY main/src/main/java/com/app/main/root/package.json ./
COPY main/src/main/java/com/app/main/root/package-lock.json ./

# Install all dependencies (including dev — needed for build)
RUN npm ci

# Copy the Next.js project
COPY main/src/main/java/com/app/main/root/ ./

# Ensure the env-config directory is available for next.config.ts
COPY main/src/main/java/com/app/main/root/.env-config/ ./.env-config/

# Build in production mode so .env.prod is loaded
ENV NODE_ENV=production
RUN npm run build

# ============================================================
# Stage 2: Runtime
# ============================================================
FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3002
ENV HOSTNAME=0.0.0.0

# Copy the built app from builder
COPY --from=builder /app ./

# Reinstall only production dependencies
RUN npm ci --omit=dev

EXPOSE 3002

CMD ["npm", "start"]